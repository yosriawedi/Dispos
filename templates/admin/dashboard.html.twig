{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
<p style="color: var(--text-secondary-color); margin-bottom: 1.5rem;">
    File d'attente des demandes qui nécessitent une action de votre part. Cliquez sur une carte pour ouvrir la liste correspondante.
</p>

<div class="dispos-kpi-grid">
    {% for kpi in kpis %}
        {% set kpiMeta = kpi.value > 0 ? 'À traiter' : 'Aucune en attente' %}
        <a
            href="{{ ea_url().setController(kpi.route).setAction('index') }}"
            class="dispos-kpi-link"
            aria-label="{{ kpi.label }} : {{ kpi.value }}, {{ kpiMeta }}"
        >
            <div class="dispos-kpi-card{{ kpi.value > 0 ? '' : ' is-empty' }}">
                <div class="kpi-label">{{ kpi.label }}</div>
                <div class="kpi-value">{{ kpi.value }}</div>
                <div class="kpi-meta">{{ kpi.value > 0 ? kpiMeta ~ ' →' : kpiMeta }}</div>
            </div>
        </a>
    {% endfor %}
</div>
{% endblock %}
