{% extends 'base.html.twig' %}
{% block title %}Publier une offre — Dis Pos{% endblock %}

{% block body %}
<section class="section" style="padding-top: 3rem;">
    <div class="container form-page">
        <h1 class="page-title">💼 Publier une offre de recrutement</h1>
        <p class="page-subtitle">Trouvez vos futurs talents parmi la communauté DisPos.</p>

        <div class="card form-card">
            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.poste, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.poste, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.poste) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.typeContrat, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.typeContrat, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.localisation, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.localisation, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
                <div class="form-group">
                    {{ form_label(form.competences, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.competences, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.salaire, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.salaire, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.dateExpiration, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.dateExpiration, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
                <div class="form-group form-check-group">
                    {{ form_widget(form.teletravail) }}
                    {{ form_label(form.teletravail, null, {'label_attr': {'class': 'form-label form-check-label'}}) }}
                </div>
                <button type="submit" class="btn btn-primary">Publier l'offre</button>
            {{ form_end(form) }}
        </div>

        <p class="form-page-link"><a href="{{ path('app_recrutement_mes_offres') }}">Voir mes offres publiées →</a></p>
    </div>
</section>

<style>
.form-page { max-width: 640px; margin: 0 auto; }
.page-title { font-size: clamp(1.8rem, 4vw, 2.2rem); font-weight: 900; margin-bottom: 0.5rem; }
.page-subtitle { color: var(--text-muted); margin-bottom: 1.75rem; }
.form-card { padding: 2rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.form-check-group { display: flex; align-items: center; gap: 0.6rem; }
.form-check-label { margin-bottom: 0 !important; text-transform: none !important; letter-spacing: normal !important; }
.form-page-link { text-align: center; margin-top: 1.25rem; }
.form-page-link a { color: var(--primary); text-decoration: none; font-size: 0.9rem; }
.form-page-link a:hover { text-decoration: underline; }
@media (max-width: 480px) { .form-row { grid-template-columns: 1fr; } }
</style>
{% endblock %}
