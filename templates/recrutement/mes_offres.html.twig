{% extends 'base.html.twig' %}
{% block title %}Mes offres publiées — Dis Pos{% endblock %}

{% block body %}
<section class="section" style="padding-top: 3rem;">
    <div class="container list-page">
        <div class="list-page-header">
            <h1 class="page-title">💼 Mes offres publiées</h1>
            <a href="{{ path('app_recrutement_publier') }}" class="btn btn-primary">+ Nouvelle offre</a>
        </div>

        {% if offres is empty %}
            <div class="empty-state">
                <div class="empty-icon">💼</div>
                <h3>Aucune offre publiée pour le moment</h3>
                <a href="{{ path('app_recrutement_publier') }}" class="btn btn-primary">Publier une offre</a>
            </div>
        {% else %}
            {% for offre in offres %}
            <a href="{{ path('app_recrutement_show', {id: offre.id}) }}" class="list-item card">
                <div class="list-item-main">
                    <div class="list-item-title">{{ offre.poste }}</div>
                    <div class="list-item-meta">{{ offre.typeContrat }} · {{ offre.candidatures|length }} candidature{{ offre.candidatures|length != 1 ? 's' : '' }}</div>
                </div>
                <div class="list-item-status">
                    {% if offre.statut == 'pourvue' %}<span class="badge badge-success">Pourvue</span>
                    {% elseif offre.statut == 'expiree' %}<span class="badge badge-danger">Expirée</span>
                    {% else %}<span class="badge badge-primary">Publiée</span>{% endif %}
                </div>
            </a>
            {% endfor %}
        {% endif %}
    </div>
</section>

<style>
.list-page { max-width: 800px; margin: 0 auto; }
.list-page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 1rem; }
.page-title { font-size: clamp(1.6rem, 4vw, 2.1rem); font-weight: 900; }
.list-item { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; text-decoration: none; color: inherit; }
.list-item-title { font-weight: 700; margin-bottom: 0.3rem; }
.list-item-meta { color: var(--text-muted); font-size: 0.85rem; }
.list-item-status { flex-shrink: 0; }
.empty-state { text-align: center; padding: 4rem 2rem; }
.empty-icon { font-size: 3.5rem; margin-bottom: 1rem; }
.empty-state h3 { font-size: 1.3rem; margin-bottom: 1.5rem; }
</style>
{% endblock %}
