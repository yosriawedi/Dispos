{% extends 'base.html.twig' %}
{% block title %}Demande d'encadrement — Dis Pos{% endblock %}

{% block body %}
<section class="section" style="padding-top: 3rem;">
    <div class="container form-page">
        <h1 class="page-title">🎓 Demande d'encadrement</h1>
        <p class="page-subtitle">PFE, PFA ou Doctorat — décrivez votre sujet et/ou la stack technique souhaitée pour un encadrement précoce.</p>

        <div class="card form-card">
            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.type, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.type, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.type) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.sujet, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.sujet, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.sujet) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.stackTech, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.stackTech, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.stackTech) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.etablissement, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.etablissement, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.niveauEtude, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.niveauEtude, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Envoyer ma demande</button>
            {{ form_end(form) }}
        </div>

        <p class="form-page-link"><a href="{{ path('app_encadrement_mes_demandes') }}">Voir mes demandes précédentes →</a></p>
    </div>
</section>

<style>
.form-page { max-width: 640px; margin: 0 auto; }
.page-title { font-size: clamp(1.8rem, 4vw, 2.2rem); font-weight: 900; margin-bottom: 0.5rem; }
.page-subtitle { color: var(--text-muted); margin-bottom: 1.75rem; }
.form-card { padding: 2rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.form-page-link { text-align: center; margin-top: 1.25rem; }
.form-page-link a { color: var(--primary); text-decoration: none; font-size: 0.9rem; }
.form-page-link a:hover { text-decoration: underline; }
@media (max-width: 480px) { .form-row { grid-template-columns: 1fr; } }
</style>
{% endblock %}
