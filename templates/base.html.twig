<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}" data-theme="{{ app.request.cookies.get('dispos_theme', 'dark') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Dis Pos — Plateforme d'Innovation{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Dis Pos connecte les talents, startups et investisseurs pour bâtir l'écosystème d'innovation de demain.{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="{{ asset('images/disposlogo.png') }}">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar" id="navbar">
        <a href="{{ path('app_home') }}" class="navbar-brand">
            <img src="{{ asset('images/disposlogo.png') }}" alt="Dis Pos">
            <span>Dis Pos</span>
        </a>
        <button class="hamburger" id="hamburger" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
        <ul class="navbar-nav nav-links" id="navLinks">
            <li><a href="{{ path('app_home') }}" class="{{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">Accueil</a></li>
            <li><a href="{{ path('app_matieres') }}" class="{{ app.request.attributes.get('_route') starts with 'app_matiere' or app.request.attributes.get('_route') starts with 'app_session' ? 'active' : '' }}">Révision</a></li>
            <li><a href="{{ path('app_projets_internes') }}" class="{{ app.request.attributes.get('_route') starts with 'app_projet_interne' or app.request.attributes.get('_route') starts with 'app_projets_internes' ? 'active' : '' }}">Projets internes</a></li>
            <li><a href="{{ path('app_recrutement') }}" class="{{ app.request.attributes.get('_route') starts with 'app_recrutement' ? 'active' : '' }}">Recrutement</a></li>
            <li><a href="{{ path('app_startups') }}" class="{{ app.request.attributes.get('_route') starts with 'app_startup' ? 'active' : '' }}">Startups</a></li>
            <li><a href="{{ path('app_talents') }}" class="{{ app.request.attributes.get('_route') == 'app_talents' ? 'active' : '' }}">Talents</a></li>
            <li><a href="{{ path('app_projects') }}" class="{{ app.request.attributes.get('_route') == 'app_projects' ? 'active' : '' }}">Projets</a></li>
        </ul>
        <div class="navbar-actions">
            <button type="button" class="theme-toggle" id="themeToggle" aria-label="Changer de thème">
                <span class="icon-dark">🌙</span>
                <span class="icon-light">☀️</span>
            </button>
            {% if app.user %}
                <a href="{{ path('app_dashboard') }}" class="btn btn-outline">Mon espace</a>
                <a href="{{ path('app_logout') }}" class="btn btn-primary">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline">Connexion</a>
                <a href="{{ path('app_register') }}" class="btn btn-primary">Rejoindre</a>
            {% endif %}
        </div>
    </nav>

    <!-- Flash Messages -->
    <div class="flash-container">
        {% for message in app.flashes('success') %}
            <div class="flash flash-success">✅ {{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash flash-error">❌ {{ message }}</div>
        {% endfor %}
    </div>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">⚡ Dis Pos</div>
                    <p class="footer-desc">La plateforme qui connecte les talents, les startups et les investisseurs pour construire l'écosystème d'innovation de demain.</p>
                </div>
                <div>
                    <div class="footer-title">Navigation</div>
                    <ul class="footer-links">
                        <li><a href="{{ path('app_startups') }}">Startups</a></li>
                        <li><a href="{{ path('app_talents') }}">Talents</a></li>
                        <li><a href="{{ path('app_projects') }}">Projets</a></li>
                    </ul>
                </div>
                <div>
                    <div class="footer-title">Compte</div>
                    <ul class="footer-links">
                        <li><a href="{{ path('app_register') }}">Créer un compte</a></li>
                        <li><a href="{{ path('app_login') }}">Se connecter</a></li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li><a href="{{ path('admin') }}">Administration</a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© {{ "now"|date("Y") }} Dis Pos — Tous droits réservés</span>
                <span>Fait avec ❤️ pour l'innovation</span>
            </div>
        </div>
    </footer>

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</body>
</html>
