{% extends 'base.html.twig' %}
{% block title %}Mon Espace — Dis Pos{% endblock %}

{% block body %}
<section class="dashboard">
    <div class="container">
        <div class="dashboard-header">
            <div class="dashboard-welcome">
                <div class="dashboard-avatar">{{ user.firstName|first }}{{ user.lastName|first }}</div>
                <div>
                    <h1>Bonjour, <span class="gradient-text">{{ user.firstName }}</span> 👋</h1>
                    <p class="dashboard-role">
                        {% set role = user.primaryRole %}
                        {% if role == 'ROLE_ETUDIANT' %}🎓 Étudiant
                        {% elseif role == 'ROLE_FORMATEUR' %}👨‍🏫 Formateur
                        {% elseif role == 'ROLE_ENTREPRISE' %}🏢 Entreprise
                        {% elseif role == 'ROLE_STARTUP' %}🚀 Entrepreneur / Startup Founder
                        {% elseif role == 'ROLE_TALENT' %}💡 Talent
                        {% elseif role == 'ROLE_INVESTOR' %}💰 Investisseur
                        {% elseif role == 'ROLE_ADMIN' %}🛡️ Administrateur
                        {% else %}Membre{% endif %}
                    </p>
                </div>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin') }}" class="btn btn-primary">Admin Panel →</a>
            {% endif %}
        </div>

        <!-- Role-specific content -->
        {% set role = user.primaryRole %}
        <div class="dashboard-grid">

            {% if role == 'ROLE_ETUDIANT' %}
            <div class="dash-card card">
                <div class="dash-card-icon">📚</div>
                <h3>Sessions de révision suivies</h3>
                <p class="dash-value">{{ statsByKey.sessions_suivies.value ?? 0 }}</p>
                <a href="{{ path('app_matieres') }}" class="btn btn-outline" style="margin-top:0.5rem;">Voir les matières</a>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">🎓</div>
                <h3>Demande d'encadrement</h3>
                <p class="dash-value">{{ statsByKey.demandes_encadrement.value ?? 0 }}</p>
                <p class="dash-meta" style="margin-top:0.5rem;">
                    <a href="{{ path('app_encadrement_nouvelle') }}" class="dash-link">📝 Nouvelle demande</a><br>
                    <a href="{{ path('app_encadrement_mes_demandes') }}" class="dash-link">📋 Mes demandes</a>
                </p>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">🤝</div>
                <h3>Paiement en compétences</h3>
                <p class="dash-value">{{ statsByKey.offres_competence.value ?? 0 }}</p>
                <p class="dash-meta" style="margin-top:0.5rem;">
                    <a href="{{ path('app_competence_nouvelle') }}" class="dash-link">📝 Proposer une compétence</a><br>
                    <a href="{{ path('app_competence_mes_offres') }}" class="dash-link">📋 Mes offres</a>
                </p>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">🛠️</div>
                <h3>Projets internes DisPos</h3>
                <p class="dash-value">{{ statsByKey.contributions.value ?? 0 }}</p>
                <p class="dash-meta" style="margin-top:0.5rem;">
                    <a href="{{ path('app_projets_internes') }}" class="dash-link">📋 Voir les projets</a><br>
                    <a href="{{ path('app_projets_internes_mes_contributions') }}" class="dash-link">📋 Mes contributions</a>
                </p>
            </div>

            {% elseif role == 'ROLE_FORMATEUR' %}
            <div class="dash-card card">
                <div class="dash-card-icon">👨‍🏫</div>
                <h3>Sessions animées</h3>
                <p class="dash-value">{{ statsByKey.sessions_animees.value ?? 0 }}</p>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">📋</div>
                <h3>Ma candidature formateur</h3>
                <p class="dash-value">{{ statsByKey.candidature_formateur.value ?? 'Aucune candidature' }}</p>
                <a href="{{ path('app_formateur_ma_candidature') }}" class="btn btn-outline" style="margin-top:0.5rem;">Voir ma candidature</a>
            </div>

            {% elseif role == 'ROLE_ENTREPRISE' %}
            <div class="dash-card card">
                <div class="dash-card-icon">💼</div>
                <h3>Offres de recrutement publiées</h3>
                <p class="dash-value">{{ statsByKey.offres_recrutement.value ?? 0 }}</p>
                <p class="dash-meta" style="margin-top:0.5rem;">
                    <a href="{{ path('app_recrutement_publier') }}" class="dash-link">📝 Publier une offre</a><br>
                    <a href="{{ path('app_recrutement_mes_offres') }}" class="dash-link">📋 Mes offres</a>
                </p>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">📬</div>
                <h3>Candidatures reçues</h3>
                <p class="dash-value">{{ statsByKey.candidatures_recues.value ?? 0 }}</p>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">🏢</div>
                <h3>Incubation TPE/PME</h3>
                <p class="dash-value" style="font-size:1.1rem;">{{ statsByKey.avancement_incubation.value ?? 'Aucun dossier' }}</p>
                <a href="{{ path('app_incubation_suivi') }}" class="btn btn-outline" style="margin-top:0.5rem;">Voir mon dossier</a>
            </div>

            {% elseif role == 'ROLE_STARTUP' %}
            <div class="dash-card card">
                <div class="dash-card-icon">🚀</div>
                <h3>Ma Startup</h3>
                {% if user.startup %}
                    <p class="dash-value">{{ user.startup.name }}</p>
                    <p class="dash-meta">{{ user.startup.sector }} · {{ user.startup.stage|capitalize }}</p>
                {% else %}
                    <p class="dash-empty">Vous n'avez pas encore créé votre startup</p>
                {% endif %}
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">📋</div>
                <h3>Projets publiés</h3>
                {% if user.startup %}
                    <p class="dash-value">{{ user.startup.projects|length }}</p>
                {% else %}
                    <p class="dash-value">0</p>
                {% endif %}
            </div>

            {% elseif role == 'ROLE_TALENT' %}
            <div class="dash-card card">
                <div class="dash-card-icon">💡</div>
                <h3>Mon profil Talent</h3>
                <p class="dash-value">{{ user.fullName }}</p>
                <p class="dash-meta">{{ user.bio ?? 'Complétez votre bio' }}</p>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">📋</div>
                <h3>Projets disponibles</h3>
                <p class="dash-value">Explorer →</p>
                <a href="{{ path('app_projects') }}" class="btn btn-outline" style="margin-top:0.5rem;">Voir les projets</a>
            </div>

            {% elseif role == 'ROLE_INVESTOR' %}
            <div class="dash-card card">
                <div class="dash-card-icon">💰</div>
                <h3>Mon portfolio</h3>
                <p class="dash-value">Investisseur</p>
                <p class="dash-meta">Accédez aux meilleures opportunités</p>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">🚀</div>
                <h3>Deal Flow</h3>
                <p class="dash-value">Explorer →</p>
                <a href="{{ path('app_startups') }}" class="btn btn-outline" style="margin-top:0.5rem;">Voir les startups</a>
            </div>
            {% endif %}

            <div class="dash-card card">
                <div class="dash-card-icon">👥</div>
                <h3>Communauté</h3>
                <p class="dash-meta" style="margin-top:0.5rem;">
                    <a href="{{ path('app_startups') }}" class="dash-link">🚀 Startups</a><br>
                    <a href="{{ path('app_talents') }}" class="dash-link">💡 Talents</a><br>
                    <a href="{{ path('app_projects') }}" class="dash-link">📋 Projets</a>
                </p>
            </div>
            <div class="dash-card card">
                <div class="dash-card-icon">🗺️</div>
                <h3>Affectations incubation</h3>
                <p class="dash-value">Référent →</p>
                <a href="{{ path('app_etape_incubation_mes_affectations') }}" class="btn btn-outline" style="margin-top:0.5rem;">Voir mes affectations</a>
            </div>

            {% if role != 'ROLE_ENTREPRISE' %}
            <div class="dash-card card">
                <div class="dash-card-icon">💼</div>
                <h3>Mes candidatures recrutement</h3>
                <p class="dash-meta" style="margin-top:0.5rem;">
                    <a href="{{ path('app_recrutement') }}" class="dash-link">🔎 Voir les offres</a><br>
                    <a href="{{ path('app_recrutement_mes_candidatures') }}" class="dash-link">📋 Mes candidatures</a>
                </p>
            </div>
            {% endif %}

            {% if role != 'ROLE_FORMATEUR' %}
            <div class="dash-card card">
                <div class="dash-card-icon">👨‍🏫</div>
                <h3>Devenir formateur</h3>
                <p class="dash-meta" style="margin-top:0.5rem;">
                    <a href="{{ path('app_formateur_postuler') }}" class="dash-link">📝 Postuler</a><br>
                    <a href="{{ path('app_formateur_ma_candidature') }}" class="dash-link">📋 Ma candidature</a>
                </p>
            </div>
            {% endif %}
        </div>

        <div class="dashboard-profile card" style="margin-top:1.5rem;">
            <div class="dashboard-profile-header">
                <h3>Informations du compte</h3>
                <a href="{{ path('app_profile_edit') }}" class="btn btn-outline btn-sm">✏️ Modifier mon profil</a>
            </div>
            <div class="profile-grid">
                <div><span class="profile-label">Email</span><span class="profile-value">{{ user.email }}</span></div>
                <div><span class="profile-label">Nom complet</span><span class="profile-value">{{ user.fullName }}</span></div>
                <div><span class="profile-label">Pays</span><span class="profile-value">{{ user.country ?? 'Non renseigné' }}</span></div>
                <div><span class="profile-label">Membre depuis</span><span class="profile-value">{{ user.createdAt|date('d/m/Y') }}</span></div>
            </div>
        </div>
    </div>
</section>

<style>
.dashboard { padding: 3rem 0; }
.dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
.dashboard-welcome { display: flex; align-items: center; gap: 1.25rem; }
.dashboard-avatar { width: 64px; height: 64px; border-radius: 50%; background: var(--gradient); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.25rem; color: #fff; flex-shrink: 0; }
.dashboard-welcome h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 0.25rem; }
.dashboard-role { color: var(--text-muted); font-size: 0.95rem; }
.dashboard-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; }
.dash-card { display: flex; flex-direction: column; }
.dash-card-icon { font-size: 2rem; margin-bottom: 0.75rem; }
.dash-card h3 { font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
.dash-value { font-size: 1.4rem; font-weight: 800; color: var(--text); }
.dash-meta { color: var(--text-muted); font-size: 0.875rem; margin-top: 0.25rem; }
.dash-empty { color: var(--text-muted); font-size: 0.875rem; font-style: italic; }
.dash-link { color: var(--primary); text-decoration: none; font-size: 0.9rem; font-weight: 500; display: inline-block; margin-bottom: 0.3rem; }
.dash-link:hover { text-decoration: underline; }
.dashboard-profile-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; }
.dashboard-profile-header h3 { margin-bottom: 0; }
.dashboard-profile h3 { font-size: 1rem; font-weight: 700; }
.btn-sm { padding: 0.4rem 0.9rem; font-size: 0.8rem; }
.profile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
.profile-label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem; }
.profile-value { font-size: 0.95rem; font-weight: 500; }
</style>
{% endblock %}
